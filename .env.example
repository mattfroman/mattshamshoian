# Required provider keys. Keep these server-side only.
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
ANTHROPIC_API_KEY=sk-ant-...

# Optional model overrides.
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-1.5-flash
ANTHROPIC_MODEL=claude-3-5-haiku-latest
ANTHROPIC_SYNTHESIS_MODEL=claude-3-5-haiku-latest

# Optional server and guardrail settings.
PORT=8787
PROMPT_MAX_CHARS=6000
REQUEST_TIMEOUT_MS=90000
PROVIDER_TIMEOUT_MS=60000
SYNTHESIS_TIMEOUT_MS=25000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=5
COUNCIL_STORE_FILE=server/data/council-runs.json
